# Copy to apps/api/.env and fill in. `.env` is gitignored; this file is committed.
# `npm run dev:api` loads apps/api/.env automatically (via process.loadEnvFile()).

# Absolute path to an existing directory the API serves files from.
# Phase 1 placeholder (mkdir -p it first):   /home/<you>/pistora-storage
# When the WD Elements 5TB is mounted:       /mnt/d/pistora
STORAGE_ROOT=

# Email of the bootstrap admin. On startup, if no admin account exists, one is
# created with this email and a one-time password printed to the server log.
ADMIN_EMAIL=

# Optional — sensible defaults shown.
# PORT=3001
# HOST=0.0.0.0
# MAX_FILE_BYTES=5368709120        # 5 GiB, per-file upload ceiling
# MAX_FILES_PER_UPLOAD=20
# CORS_ORIGINS=https://pistora.se,https://www.pistora.se
#   Unset (dev): allows pistora.se + any http(s)://localhost:<port> / 127.0.0.1.
#   Set (prod):  exact allowlist, no localhost fallback. Comma-separated.
# LOG=on                           # set to "off" to silence the request logger
#
# ---- auth ----
# DB_PATH=data/pistora.db          # SQLite file for users + sessions; dir auto-created
#                                    (relative paths resolve from apps/api/)
# SESSION_TTL_HOURS=720            # 30 days
# COOKIE_SECURE=true               # set to "false" for local http dev (no HTTPS)
# COOKIE_DOMAIN=                    # leave unset — host-only cookie on api.pistora.se
# EXPOSE_INVITE_OTP=false          # "true" makes POST /api/admin/users return the OTP
#                                    in the body (handy for local testing only)
