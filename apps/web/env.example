# Copy to apps/web/.env.local and adjust. `.env*` is gitignored; this file is committed.
# Next.js auto-loads apps/web/.env.local. NEXT_PUBLIC_* vars are inlined at BUILD time.

# Base URL of the Pistora storage API. Unset falls back to https://api.pistora.se.
# LOCAL DEV: keep the line below and run `npm run dev:api` in another terminal.
#
# Cookie auth only works when the API is the SAME registrable site as the web
# app: localhost:3001 <-> localhost:3000, or api.pistora.se <-> pistora.se.
# A *.trycloudflare.com quick tunnel is a DIFFERENT site — login will loop.
NEXT_PUBLIC_API_BASE=http://localhost:3001
