# Copy to apps/web/.env.local and adjust. `.env*` is gitignored; this file is committed.
# Next.js auto-loads apps/web/.env.local. NEXT_PUBLIC_* vars are inlined at BUILD time.

# Base URL of the Pistora storage API. Defaults to http://localhost:3001 if unset.
# LAN dev: leave as-is and run `npm run dev:api` in another terminal.
# Production builds MUST set this (e.g. https://api.pistora.se) — an unset var
# bakes in the localhost default.
NEXT_PUBLIC_API_BASE=http://localhost:3001
