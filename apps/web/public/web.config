<?xml version="1.0" encoding="utf-8"?>
<!--
  Served from wwwroot root (Next copies public/ into out/ verbatim on export).
  Two jobs for IIS, which a plain static-file export doesn't handle on its own:

  1. Force HTTPS. The API's CORS allowlist is https-only and the session
     cookie is Secure, so an http:// visitor is silently broken (CORS-blocked
     API calls, cookie never set) with no useful error. Redirect before that
     happens.
  2. Serve the app's own 404 page (exported to /404.html) instead of IIS's
     default one, and register MIME types for a few static-export file kinds
     that stock IIS doesn't always know.

  Deep links (/files/, /login/, /admin/, /account/password/) don't need a
  rewrite rule here: `trailingSlash: true` in next.config.ts exports each
  route as `<route>/index.html`, and IIS's own default-document + directory
  redirect handles the rest.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
